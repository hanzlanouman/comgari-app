{
  "expo": {
    "name": "comgari",
    "slug": "comgari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "comgari",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.comgari",
      "usesIcloudStorage": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.591433819621-j21up9ffi29k3hko48j3flht7ma185au"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.comgari.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.DOWNLOAD_COMPLETE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.591433819621-j21up9ffi29k3hko48j3flht7ma185au"
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Comgari needs access to your photos to let you upload your profile picture, media and notes images."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Comgari needs access to your photos to let you upload your profile picture, media and notes images.",
          "savePhotosPermission": "Comgari needs access to save invoices and proposals to your device.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "@config-plugins/react-native-blob-util"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "84b95d5a-9897-419a-bf78-8c5fc7f65718"
      }
    },
    "owner": "moaaz_murtaza"
  }
}
