{
  "expo": {
    "name": "comgari",
    "slug": "comgari",
    "version": "1.0.54",
    "orientation": "portrait",
    "icon": "./assets/images/adaptive-icon.png",
    "scheme": "comgari",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.comgari",
      "usesIcloudStorage": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.591433819621-j21up9ffi29k3hko48j3flht7ma185au"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.591433819621-j21up9ffi29k3hko48j3flht7ma185au"
            ]
          }
        ],
        "NSPhotoLibraryUsageDescription": "Comgari needs access to your photos to let you upload your profile picture, media and notes images.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.comgari.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.DOWNLOAD_COMPLETE",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.591433819621-j21up9ffi29k3hko48j3flht7ma185au"
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Comgari needs access to your photos to let you upload your profile picture, media and notes images."
        }
      ],
      "@config-plugins/react-native-blob-util",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./assets/images/splashIcon.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff",
            "imageWidth": 300
          },
          "ios": {
            "image": "./assets/images/splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-web-browser",
      "./plugins/remove-media-permissions"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "aceacd83-9f20-4549-a495-bb267de1ca07"
      }
    }
  }
}
